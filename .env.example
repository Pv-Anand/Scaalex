# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development

# Set to "true" only once the app is actually served over HTTPS (e.g. on
# Render, behind their TLS termination). Leave unset for local http:// dev -
# a "secure" cookie set locally would never be sent back over plain http.
FORCE_HTTPS=

# Where the SQLite file and uploaded files live. Leave blank locally (uses the
# project directory). On a host with a persistent disk (e.g. Render), set this
# to that disk's mount path so data survives deploys/restarts.
DATA_DIR=

# Database (SQLite by default; point DATABASE_URL at Postgres for production)
# Leave blank to use the default path (instance/scaalex.db under DATA_DIR).
DATABASE_URL=

# Anthropic (used for extraction, summaries, leadership overview, email drafts)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Fireflies (meeting sync). Get a key from Fireflies -> Settings -> Developer
# Settings -> API Key. Leave blank to disable the Fireflies section entirely.
FIREFLIES_API_KEY=

# Google Calendar (upcoming meetings on the Meetings page). Create an OAuth
# client in Google Cloud Console (APIs & Services -> Credentials -> Create
# Credentials -> OAuth client ID -> Web application) and register both
# http://localhost:5050/calendar/oauth/callback and
# https://<your-render-url>/calendar/oauth/callback as authorized redirect
# URIs. Leave blank to disable Upcoming Meetings entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# File uploads
MAX_UPLOAD_MB=50
